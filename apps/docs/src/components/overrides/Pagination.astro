---
/** Previous / next as small pills at the end of the page (shadcn/ui style). */
const { pagination } = Astro.locals.starlightRoute
const { prev, next } = pagination
---

<div class="cl-pagination print:hidden">
  {
    prev ? (
      <a href={prev.href} rel="prev" class="cl-pill">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7" />
          <path d="M19 12H5" />
        </svg>
        {prev.label}
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a href={next.href} rel="next" class="cl-pill">
        {next.label}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    )
  }
</div>
