---
/**
 * Starlight's article body, plus the in-article ad unit. The unit is rendered
 * after the content and moved to just before the first `##` heading (so it
 * sits after the intro and the live demo, inside the article as AdSense wants).
 */
import Default from "@astrojs/starlight/components/MarkdownContent.astro"

import AdSlot from "../AdSlot.astro"

const { entry } = Astro.locals.starlightRoute
const showAds = entry.data.template !== "splash" && !entry.id.endsWith("404")
---

<Default><slot /></Default>
{showAds && <AdSlot slot="5823711231" format="fluid" class="cl-ad-in-article" />}

<script>
  // Phones: every table row becomes a card (see responsive.css), each cell
  // labelled with its column header through `data-label`
  for (const table of document.querySelectorAll<HTMLTableElement>(".sl-markdown-content table")) {
    // Live demos (`.not-content`) render their own <table>; leave them alone
    if (table.closest(".not-content")) continue
    const labels = [...table.querySelectorAll("thead th")].map((th) => th.textContent?.trim() ?? "")
    if (labels.length === 0) continue
    table.classList.add("cl-table-cards")
    for (const row of table.querySelectorAll("tbody tr")) {
      row.querySelectorAll("td").forEach((cell, index) => {
        if (labels[index]) cell.dataset.label = labels[index]
        if (!cell.textContent?.trim()) {
          cell.dataset.empty = ""
          return
        }
        // The card cell is a two-column grid (label, value): keep the value as
        // one grid item even when it mixes text, code and links
        const value = document.createElement("span")
        value.append(...cell.childNodes)
        cell.append(value)
      })
    }
  }

  const ad = document.querySelector(".cl-ad-in-article")
  // Starlight wraps each heading in `.sl-heading-wrapper`; go before the first level-2 one
  const firstHeading = document.querySelector(".sl-markdown-content .sl-heading-wrapper.level-h2, .sl-markdown-content h2")
  const target = firstHeading?.closest(".sl-heading-wrapper") ?? firstHeading
  // Runs before the ads script arrives (it loads after `load`), so the unit is in place when filled
  if (ad && target) target.before(ad)
</script>
