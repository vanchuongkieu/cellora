---
/**
 * shadcn/ui-style header: logo and section links on the left; search,
 * GitHub, theme switch, language and the main call to action on the right.
 */
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro"
import Search from "@astrojs/starlight/components/Search.astro"

import { localePath, ui } from "../../i18n"
import { SITE } from "../../site"
import ThemeToggle from "../ThemeToggle.astro"
import SiteTitle from "./SiteTitle.astro"

const { locale } = Astro.locals.starlightRoute
const t = ui(locale)
const path = Astro.url.pathname
const links = [
  { label: t.docs, href: localePath(locale, "/getting-started/introduction/"), section: "/getting-started/" },
  { label: t.features, href: localePath(locale, "/features/sorting/"), section: "/features/" },
  { label: t.api, href: localePath(locale, "/api/data-grid/"), section: "/api/" },
]
---

<div class="cl-header">
  <SiteTitle />
  <nav class="cl-nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={path.includes(link.section) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="cl-header-end">
    <Search />
    <div class="cl-header-tools">
      <a class="cl-icon-button" href={SITE.repo} aria-label="GitHub" title="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
      </a>
      <span class="cl-separator" aria-hidden="true"></span>
      <ThemeToggle />
      <LanguageSelect />
      <a class="cl-button-primary" href={localePath(locale, "/getting-started/quick-start/")}>{t.getStarted}</a>
    </div>
  </div>
</div>
