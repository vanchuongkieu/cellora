---
/**
 * Page heading like shadcn/ui: title, muted description, and on the right
 * "Copy Page" (the page's Markdown, handy for LLMs) plus previous / next.
 */
import { ui } from "../../i18n"

const { entry, pagination, locale } = Astro.locals.starlightRoute
const { title, description } = entry.data
const t = ui(locale)
---

<div class="cl-page-head">
  <div class="cl-page-head-row">
    <h1 id="_top">{title}</h1>
    <div class="cl-page-actions">
      {
        entry.body && (
          <button type="button" class="cl-button-secondary" data-copy-page data-markdown={entry.body} data-copied={t.copied}>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <span>{t.copyPage}</span>
          </button>
        )
      }
      {
        pagination.prev && (
          <a class="cl-icon-button cl-button-square" href={pagination.prev.href} aria-label={`${t.previous}: ${pagination.prev.label}`} title={pagination.prev.label}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m12 19-7-7 7-7" />
              <path d="M19 12H5" />
            </svg>
          </a>
        )
      }
      {
        pagination.next && (
          <a class="cl-icon-button cl-button-square" href={pagination.next.href} aria-label={`${t.next}: ${pagination.next.label}`} title={pagination.next.label}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
  {description && <p class="cl-page-description">{description}</p>}
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-page]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.markdown ?? "")
      const label = button.querySelector("span")
      if (!label) return
      const original = label.textContent
      label.textContent = button.dataset.copied ?? ""
      setTimeout(() => (label.textContent = original), 1500)
    })
  }
</script>
