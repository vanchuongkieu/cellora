---
/** Logo + name, small like shadcn/ui's header. */
import logoDark from "../../assets/logo-dark.svg"
import logoLight from "../../assets/logo-light.svg"

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="cl-site-title">
  <img src={logoLight.src} alt="Cellora logo" width="12" height="16" class="dark:sl-hidden" style="height: 16px; width: 12px; margin-top: -1px" />
  <img src={logoDark.src} alt="Cellora logo" width="12" height="16" class="light:sl-hidden" style="height: 16px; width: 12px; margin-top: -1px" />
  <span translate="no">{siteTitle}</span>
</a>
