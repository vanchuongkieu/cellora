---
/**
 * Starlight's head, plus two things that stop the page from flashing:
 *
 * - The theme is applied before any stylesheet loads. Starlight ships the page
 *   as `data-theme="dark"` and only switches to the saved theme in a script
 *   that runs after the CSS, so a light-mode visitor saw a dark frame first.
 * - The fonts are preloaded, so text is not drawn in a fallback font and then
 *   redrawn in Geist on every page load.
 */
import Default from "@astrojs/starlight/components/Head.astro"

import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url"
import geistVietnamese from "@fontsource-variable/geist/files/geist-vietnamese-wght-normal.woff2?url"
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url"

import { localePath, ui } from "../../i18n"
import { SITE } from "../../site"

const { locale, entry, sidebar } = Astro.locals.starlightRoute
const fonts = locale === "vi" ? [geistLatin, geistVietnamese, geistMonoLatin] : [geistLatin, geistMonoLatin]

// Breadcrumb structured data: Home › section (the sidebar group) › page.
// Helps Google show the site structure (and sitelinks) for the documentation.
const t = ui(locale)
const slug = entry.id.replace(/^vi\//, "")
type SidebarGroup = Extract<(typeof sidebar)[number], { type: "group" }>
const groups = sidebar.filter((item): item is SidebarGroup => item.type === "group")
const section = groups.find((group) => group.entries.some((link) => link.type === "link" && link.href.replace(/\/$/, "").endsWith(slug)))
// A section has no page of its own: its crumb points at the group's first page
const firstLink = section?.entries.find((link) => link.type === "link")
const sectionHref = firstLink && firstLink.type === "link" ? firstLink.href : undefined
const isLanding = slug === "" || slug === "index" || entry.id === "vi"
const crumbs = isLanding
  ? []
  : [
      { name: SITE.name, item: `${SITE.url}${localePath(locale, "/")}` },
      ...(section && sectionHref ? [{ name: section.label, item: `${SITE.url}${sectionHref}` }] : []),
      { name: entry.data.title, item: `${SITE.url}${localePath(locale, `/${slug}/`)}` },
    ]
const breadcrumbs =
  crumbs.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: crumbs.map((crumb, index) => ({ "@type": "ListItem", position: index + 1, name: crumb.name, item: crumb.item })),
      })
    : null
void t
---

<script is:inline>
  ;(() => {
    try {
      const stored = localStorage.getItem("starlight-theme")
      const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark"
      document.documentElement.dataset.theme = theme
    } catch {
      /* no storage access: Starlight's own script decides */
    }
  })()
</script>
{fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<Default />
{breadcrumbs && <script type="application/ld+json" set:html={breadcrumbs} />}
