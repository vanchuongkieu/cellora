# Cloudflare response headers (Workers static assets)
# Hashed build assets never change: cache them for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Share image and icon: a day in caches, so link previews come back fast
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400

# Search index chunks are content-hashed by Pagefind
/pagefind/*
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
