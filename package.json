{
  "name": "cellora-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build && bun run --parallel dev:core dev:react dev:playground",
    "dev:core": "bun --filter @cellora/core dev",
    "dev:react": "bun --filter @cellora/react dev",
    "dev:playground": "bun --filter playground-react dev",
    "dev:docs": "bun run build && bun --filter docs dev",
    "build": "bun --filter './packages/*' build",
    "build:docs": "bun run build && bun --filter docs build",
    "deploy:docs": "bun run build:docs && wrangler deploy",
    "release": "bun run build && cd packages/core && bun publish && cd ../react && bun publish",
    "release:dry": "bun run build && cd packages/core && bun publish --dry-run && cd ../react && bun publish --dry-run",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\" \"apps/docs/src/**/*.{ts,tsx,mdx,css}\" \"apps/docs/*.mjs\" \"*.{json,mjs,md}\" && bun --filter playground-react format"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "wrangler": "^4.151.0"
  }
}
